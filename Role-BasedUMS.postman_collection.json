{
  "info": {
    "name": "Role-Based UMS Microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "internalUserServiceUrl", "value": "http://localhost:3004" },
    { "key": "userEmail", "value": "postman.user@example.com" },
    { "key": "adminEmail", "value": "postman.admin@example.com" },
    { "key": "password", "value": "Password123!" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "01 Register User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/register/userregister",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"user\",\n  \"phone\": \"1112223333\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created or already exists', function () { pm.expect([201, 400]).to.include(pm.response.code); });"] } }]
    },
    {
      "name": "02 Register Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/register/userregister",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\",\n  \"phone\": \"9998887777\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created or already exists', function () { pm.expect([201, 400]).to.include(pm.response.code); });"] } }]
    },
    {
      "name": "03 Duplicate Email Rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/register/userregister",
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"user\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Duplicate rejected', function () { pm.response.to.have.status(400); });"] } }]
    },
    {
      "name": "04 User Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"user\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User login successful', function () { pm.response.to.have.status(200); });", "pm.collectionVariables.set('userToken', pm.response.json().token);"] } }]
    },
    {
      "name": "05 Admin Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\"\n}" }
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin login successful', function () { pm.response.to.have.status(200); });", "pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }]
    },
    {
      "name": "06 Invalid Password",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrong\",\n  \"role\": \"user\"\n}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid password rejected', function () { pm.response.to.have.status(401); });"] } }]
    },
    {
      "name": "07 Wrong Role",
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\"\n}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Wrong role rejected', function () { pm.response.to.have.status(403); });"] } }]
    },
    {
      "name": "08 Admin View All Users",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/viewalluser" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin can view all users', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "09 Admin Search User Found",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/searchuser?email={{userEmail}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User found', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "10 Admin Search User Not Found",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/searchuser?email=missing@example.com" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Missing user not found', function () { pm.response.to.have.status(404); });"] } }]
    },
    {
      "name": "11 User View Profile",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/user/viewprofile" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User can view profile', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "12 User Update Profile",
      "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/user/updateprofile", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Postman User\",\n  \"phone\": \"4445556666\"\n}" } },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User can update profile', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "13 No Token Rejected",
      "request": { "method": "GET", "url": "{{baseUrl}}/admin/viewalluser" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('No token rejected', function () { pm.response.to.have.status(401); });"] } }]
    },
    {
      "name": "14 Wrong Token Rejected",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer wrong.token.value" }], "url": "{{baseUrl}}/admin/viewalluser" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Wrong token rejected', function () { pm.response.to.have.status(401); });"] } }]
    },
    {
      "name": "15 Admin Blocked From User API",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/user/viewprofile" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin blocked from user API', function () { pm.response.to.have.status(403); });"] } }]
    },
    {
      "name": "16 User Blocked From Admin API",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }], "url": "{{baseUrl}}/admin/viewalluser" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User blocked from admin API', function () { pm.response.to.have.status(403); });"] } }]
    },
    {
      "name": "17 Direct Internal Service Rejected",
      "request": { "method": "GET", "url": "{{internalUserServiceUrl}}/api/user/viewprofile" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Direct service access rejected', function () { pm.response.to.have.status(403); });"] } }]
    },
    {
      "name": "18 Admin Delete Test User",
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/deluser?email={{userEmail}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Test user deleted', function () { pm.response.to.have.status(200); });"] } }]
    }
  ]
}
