{
  "info": {
    "name": "Role-Based UMS Microservices",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "internalUserServiceUrl",
      "value": "http://localhost:3004"
    },
    {
      "key": "userEmail",
      "value": "postman.user@example.com"
    },
    {
      "key": "adminEmail",
      "value": "postman.admin@example.com"
    },
    {
      "key": "password",
      "value": "Password123!"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Gateway Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Gateway healthy', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Register User",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/register/userregister",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"user\",\n  \"phone\": \"1112223333\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created or already exists', function () { pm.expect([201, 400]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Register Admin",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/register/userregister",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\",\n  \"phone\": \"9998887777\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created or already exists', function () { pm.expect([201, 400]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Duplicate Email Rejected",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/register/userregister",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Duplicate User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"user\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate rejected', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Invalid Registration Role",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/register/userregister",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bad Role\",\n  \"email\": \"bad.role@example.com\",\n  \"password\": \"{{password}}\",\n  \"role\": \"guest\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid registration role rejected', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 User Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"user\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User login successful', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('userToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Admin Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login successful', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Invalid Password",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrong\",\n  \"role\": \"user\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid password rejected', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Invalid Login Role",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"guest\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid login role rejected', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Wrong Account Role",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Wrong account role rejected', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Admin View All Users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/viewalluser",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin can view all users', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Admin Search User Found",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/searchuser?email={{userEmail}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User found', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Admin Search User Not Found",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/searchuser?email=missing@example.com",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing user not found', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Admin Search Missing Criteria",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/searchuser",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Search without criteria rejected', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 User View Profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user/viewprofile",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User can view profile', function () { pm.response.to.have.status(200); });",
              "pm.test('Profile belongs to token user', function () { pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('userEmail')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "15 User Update Profile",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/user/updateprofile",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Postman User\",\n  \"phone\": \"4445556666\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User can update profile', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16 User Empty Update Rejected",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/user/updateprofile",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Empty update rejected', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "17 User Update Cannot Change Email Or Role",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/user/updateprofile",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Postman User\",\n  \"email\": \"attacker@example.com\",\n  \"role\": \"admin\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unsafe profile fields ignored', function () { pm.response.to.have.status(200); });",
              "pm.test('Email still belongs to token user', function () { pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('userEmail')); });",
              "pm.test('Role still user', function () { pm.expect(pm.response.json().user.role).to.eql('user'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "18 No Token Rejected",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/viewalluser"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('No token rejected', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "19 Wrong Token Rejected",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/viewalluser",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer wrong.token.value"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Wrong token rejected', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "20 Admin Blocked From User API",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user/viewprofile",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin blocked from user API', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "21 User Blocked From Admin API",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/viewalluser",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('User blocked from admin API', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "22 Direct Internal Service Rejected",
      "request": {
        "method": "GET",
        "url": "{{internalUserServiceUrl}}/api/user/viewprofile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Direct service access rejected', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Admin Delete Test User",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/admin/deluser?email={{userEmail}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Test user deleted', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
